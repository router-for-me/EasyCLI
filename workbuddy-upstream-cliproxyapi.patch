+	workbuddyauth "github.com/router-for-me/CLIProxyAPI/v8/internal/auth/workbuddy"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/runtime/executor/helps"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/thinking"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/util"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v8/sdk/translator"
+	log "github.com/sirupsen/logrus"
+	"github.com/tidwall/gjson"
+	"github.com/tidwall/sjson"
+)
+
+var (
+	_ cliproxyauth.ProviderExecutor    = (*WorkBuddyExecutor)(nil)
+	_ cliproxyauth.RequestAuthPreparer = (*WorkBuddyExecutor)(nil)
+)
+
+const defaultWorkBuddySystemPrompt = "You are a helpful assistant."
+
+// WorkBuddyExecutor implements cliproxyauth.ProviderExecutor for Tencent WorkBuddy (www.workbuddy.ai / copilot.tencent.com).
+type WorkBuddyExecutor struct {
+	cfg *config.Config
+}
+
+// NewWorkBuddyExecutor constructs a new WorkBuddy executor.
+func NewWorkBuddyExecutor(cfg *config.Config) *WorkBuddyExecutor {
+	return &WorkBuddyExecutor{cfg: cfg}
+}
+
+// Identifier returns the provider identifier "workbuddy".
+func (e *WorkBuddyExecutor) Identifier() string {
+	return "workbuddy"
+}
+
+func workbuddyCreds(auth *cliproxyauth.Auth) (realm, uid, token string) {
+	realm = "intl"
+	uid = "anonymous"
+	if auth == nil {
+		return realm, uid, ""
+	}
+	if auth.Metadata != nil {
+		if r, ok := auth.Metadata["realm"].(string); ok && strings.TrimSpace(r) != "" {
+			realm = strings.TrimSpace(r)
+		}
+		if u, ok := auth.Metadata["uid"].(string); ok && strings.TrimSpace(u) != "" {
+			uid = strings.TrimSpace(u)
+		}
+		if t, ok := auth.Metadata["access_token"].(string); ok && strings.TrimSpace(t) != "" {
+			token = strings.TrimSpace(t)
+		}
+		if token == "" {
+			if t, ok := auth.Metadata["accessToken"].(string); ok && strings.TrimSpace(t) != "" {
+				token = strings.TrimSpace(t)
+			}
+		}
+	}
+	if token == "" && auth.Attributes != nil {
+		if t := strings.TrimSpace(auth.Attributes["access_token"]); t != "" {
+			token = t
+		}
+		if token == "" {
+			if k := strings.TrimSpace(auth.Attributes["api_key"]); k != "" {
+				token = k
+			}
+		}
+		if r := strings.TrimSpace(auth.Attributes["realm"]); r != "" {
+			realm = r
+		}
+		if u := strings.TrimSpace(auth.Attributes["uid"]); u != "" {
+			uid = u
+		}
+	}
+	if uid == "anonymous" && token != "" {
+		if extracted := workbuddyauth.ExtractUIDFromJWT(token); extracted != "" {
+			uid = extracted
+		}
+	}
+	return realm, uid, token
+}
+
+// PrepareRequest injects WorkBuddy specific headers and authorization into the outgoing HTTP request.
+func (e *WorkBuddyExecutor) PrepareRequest(req *http.Request, auth *cliproxyauth.Auth) error {
+	if req == nil {
+		return nil
+	}
+	realm, uid, token := workbuddyCreds(auth)
+	headers := workbuddyauth.BuildIdentityHeaders(realm, uid, token, "")
+	for k, v := range headers {
+		req.Header.Set(k, v)
+	}
+
+	var attrs map[string]string
+	if auth != nil {
+		attrs = auth.Attributes
+	}
+	util.ApplyCustomHeadersFromAttrs(req, attrs)
+	return nil
+}
+
+// HttpRequest injects WorkBuddy credentials into the request and executes it.
+func (e *WorkBuddyExecutor) HttpRequest(ctx context.Context, auth *cliproxyauth.Auth, req *http.Request) (*http.Response, error) {
+	if req == nil {
+		return nil, fmt.Errorf("workbuddy executor: request is nil")
+	}
+	if ctx == nil {
+		ctx = req.Context()
+	}
+	httpReq := req.WithContext(ctx)
+	if err := e.PrepareRequest(httpReq, auth); err != nil {
+		return nil, err
+	}
+	httpClient := helps.NewProxyAwareHTTPClient(ctx, e.cfg, auth, 0)
+	return httpClient.Do(httpReq)
+}
+
+// Refresh checks and refreshes expired WorkBuddy credentials.
+func (e *WorkBuddyExecutor) Refresh(ctx context.Context, auth *cliproxyauth.Auth) (*cliproxyauth.Auth, error) {
+	if auth == nil {
+		return nil, fmt.Errorf("workbuddy executor: auth is nil")
+	}
+	return auth, nil
+}
+
+// ShouldPrepareRequestAuth indicates whether the credentials require preparation before request dispatch.
+func (e *WorkBuddyExecutor) ShouldPrepareRequestAuth(auth *cliproxyauth.Auth) bool {
+	if auth == nil {
+		return false
+	}
+	_, _, token := workbuddyCreds(auth)
+	return token == ""
+}
+
+// PrepareRequestAuth prepares authentication metadata if needed.
+func (e *WorkBuddyExecutor) PrepareRequestAuth(ctx context.Context, auth *cliproxyauth.Auth) (*cliproxyauth.Auth, error) {
+	return auth, nil
+}
+
+// CountTokens provides token estimation for WorkBuddy requests.
+func (e *WorkBuddyExecutor) CountTokens(ctx context.Context, auth *cliproxyauth.Auth, req cliproxyexecutor.Request, opts cliproxyexecutor.Options) (cliproxyexecutor.Response, error) {
+	return cliproxyexecutor.Response{}, nil
+}
+
+func cleanWorkBuddyModel(model string) string {
+	m := strings.TrimSpace(model)
+	for _, p := range []string{"workbuddy/", "codebuddy/", "workbuddy:", "codebuddy:"} {
+		if strings.HasPrefix(strings.ToLower(m), p) {
+			m = m[len(p):]
+			break
+		}
+	}
+	return strings.TrimSpace(thinking.ParseSuffix(m).ModelName)
+}
+
+// Execute performs non-streaming execution against Tencent WorkBuddy.
+func (e *WorkBuddyExecutor) Execute(ctx context.Context, auth *cliproxyauth.Auth, req cliproxyexecutor.Request, opts cliproxyexecutor.Options) (resp cliproxyexecutor.Response, err error) {
+	ctx = helps.EnsureSessionContext(ctx, opts, req.Payload)
+	baseModel := cleanWorkBuddyModel(req.Model)
+
+	reporter := helps.NewExecutorUsageReporter(ctx, e, baseModel, auth)
+	defer reporter.TrackFailure(ctx, &err)
+
+	realm, uid, token := workbuddyCreds(auth)
+	if token == "" {
+		return resp, statusErr{code: http.StatusUnauthorized, msg: "missing workbuddy access token"}
+	}
+
+	from := opts.SourceFormat
+	to := sdktranslator.FromString("openai")
+	isCompat := helps.APIKeyModelIsCompat(req)
+
+	originalPayloadSource := req.Payload
+	if len(opts.OriginalRequest) > 0 {
+		originalPayloadSource = opts.OriginalRequest
+	}
+	originalPayload := originalPayloadSource
+
+	_, translated, updatesChanged, err := helps.TranslateRequestPairWithAPIKeyModelCompatibilityAndUpdateIntent(
+		ctx, opts.Headers, e.cfg, from, to, baseModel, originalPayload, req.Payload, false, isCompat,
+	)
+	if err != nil {
+		return resp, err
+	}
+
+	translated, err = helps.ApplyRequestThinking(translated, req, opts, from.String(), to.String(), e.Identifier(), updatesChanged)
+	if err != nil {
+		return resp, err
+	}
+
+	translated = normalizeWorkBuddyPayload(translated, baseModel)
+	url := fmt.Sprintf("%s/v2/chat/completions", workbuddyauth.OriginForRealm(realm))
+
+	httpReq, err := http.NewRequestWithContext(ctx, http.MethodPost, url, bytes.NewReader(translated))
+	if err != nil {
+		return resp, err
+	}
+	httpReq.Header.Set("Content-Type", "application/json")
+	if err := e.PrepareRequest(httpReq, auth); err != nil {
+		return resp, err
+	}
+
+	helps.RecordAPIRequest(ctx, e.cfg, helps.UpstreamRequestLog{
+		URL:       url,
+		Method:    http.MethodPost,
+		Headers:   httpReq.Header.Clone(),
+		Body:      translated,
+		Provider:  e.Identifier(),
+		AuthID:    uid,
+		AuthLabel: fmt.Sprintf("workbuddy (%s)", realm),
+		AuthType:  "oauth",
+		AuthValue: util.HideAPIKey(token),
+	})
+
+	httpClient := reporter.TrackHTTPClient(helps.NewProxyAwareHTTPClient(ctx, e.cfg, auth, 0))
+	httpResp, errDo := httpClient.Do(httpReq)
+	if errDo != nil {
+		helps.RecordAPIResponseError(ctx, e.cfg, errDo)
+		return resp, errDo
+	}
+	defer httpResp.Body.Close()
+
+	helps.RecordAPIResponseMetadata(ctx, e.cfg, httpResp.StatusCode, httpResp.Header.Clone())
+	respBody, errRead := io.ReadAll(httpResp.Body)
+	if errRead != nil {
+		helps.RecordAPIResponseError(ctx, e.cfg, errRead)
+		return resp, errRead
+	}
+	helps.AppendAPIResponseChunk(ctx, e.cfg, respBody)
+
+	if httpResp.StatusCode < 200 || httpResp.StatusCode >= 300 {
+		return resp, statusErr{code: httpResp.StatusCode, msg: string(respBody)}
+	}
+
+	targetFormat := cliproxyexecutor.ResponseFormatOrSource(opts)
+	var param any
+	out := sdktranslator.TranslateNonStream(ctx, sdktranslator.FormatOpenAI, targetFormat, req.Model, helps.ApplyPatchOriginalRequest(req, opts), req.Payload, respBody, &param)
+	return cliproxyexecutor.Response{Payload: out, Headers: httpResp.Header.Clone()}, nil
+}
+
+// ExecuteStream performs streaming execution against Tencent WorkBuddy.
+func (e *WorkBuddyExecutor) ExecuteStream(ctx context.Context, auth *cliproxyauth.Auth, req cliproxyexecutor.Request, opts cliproxyexecutor.Options) (_ *cliproxyexecutor.StreamResult, err error) {
+	ctx = helps.EnsureSessionContext(ctx, opts, req.Payload)
+	baseModel := cleanWorkBuddyModel(req.Model)
+
+	reporter := helps.NewExecutorUsageReporter(ctx, e, baseModel, auth)
+	defer reporter.TrackFailure(ctx, &err)
+
+	realm, uid, token := workbuddyCreds(auth)
+	if token == "" {
+		return nil, statusErr{code: http.StatusUnauthorized, msg: "missing workbuddy access token"}
+	}
+
+	from := opts.SourceFormat
+	to := sdktranslator.FromString("openai")
+	isCompat := helps.APIKeyModelIsCompat(req)
+
+	originalPayloadSource := req.Payload
+	if len(opts.OriginalRequest) > 0 {
+		originalPayloadSource = opts.OriginalRequest
+	}
+	originalPayload := originalPayloadSource
+
+	_, translated, updatesChanged, err := helps.TranslateRequestPairWithAPIKeyModelCompatibilityAndUpdateIntent(
+		ctx, opts.Headers, e.cfg, from, to, baseModel, originalPayload, req.Payload, true, isCompat,
+	)
+	if err != nil {
+		return nil, err
+	}
+
+	translated, err = helps.ApplyRequestThinking(translated, req, opts, from.String(), to.String(), e.Identifier(), updatesChanged)
+	if err != nil {
+		return nil, err
+	}
+
+	translated = normalizeWorkBuddyPayload(translated, baseModel)
+	url := fmt.Sprintf("%s/v2/chat/completions", workbuddyauth.OriginForRealm(realm))
+
+	httpReq, err := http.NewRequestWithContext(ctx, http.MethodPost, url, bytes.NewReader(translated))
+	if err != nil {
+		return nil, err
+	}
+	httpReq.Header.Set("Content-Type", "application/json")
+	if err := e.PrepareRequest(httpReq, auth); err != nil {
+		return nil, err
+	}
+
+	helps.RecordAPIRequest(ctx, e.cfg, helps.UpstreamRequestLog{
+		URL:       url,
+		Method:    http.MethodPost,
+		Headers:   httpReq.Header.Clone(),
+		Body:      translated,
+		Provider:  e.Identifier(),
+		AuthID:    uid,
+		AuthLabel: fmt.Sprintf("workbuddy (%s)", realm),
+		AuthType:  "oauth",
+		AuthValue: util.HideAPIKey(token),
+	})
+
+	httpClient := reporter.TrackHTTPClient(helps.NewProxyAwareHTTPClient(ctx, e.cfg, auth, 0))
+	httpResp, errDo := httpClient.Do(httpReq)
+	if errDo != nil {
+		helps.RecordAPIResponseError(ctx, e.cfg, errDo)
+		return nil, errDo
+	}
+
+	helps.RecordAPIResponseMetadata(ctx, e.cfg, httpResp.StatusCode, httpResp.Header.Clone())
+	if httpResp.StatusCode < 200 || httpResp.StatusCode >= 300 {
+		defer httpResp.Body.Close()
+		errBytes, _ := io.ReadAll(io.LimitReader(httpResp.Body, 64*1024))
+		helps.AppendAPIResponseChunk(ctx, e.cfg, errBytes)
+		return nil, statusErr{code: httpResp.StatusCode, msg: string(errBytes)}
+	}
+
+	targetFormat := cliproxyexecutor.ResponseFormatOrSource(opts)
+	outChan := make(chan cliproxyexecutor.StreamChunk, 100)
+
+	go func() {
+		defer httpResp.Body.Close()
+		defer close(outChan)
+
+		reader := bufio.NewReader(httpResp.Body)
+		var param any
+
+		for {
+			line, errLine := reader.ReadBytes('\n')
+			if len(line) > 0 {
+				helps.AppendAPIResponseChunk(ctx, e.cfg, line)
+				trimmed := bytes.TrimSpace(line)
+				if bytes.HasPrefix(trimmed, []byte("data:")) {
+					dataPayload := bytes.TrimPrefix(trimmed, []byte("data:"))
+					dataPayload = bytes.TrimSpace(dataPayload)
+					if string(dataPayload) == "[DONE]" {
+						outChan <- cliproxyexecutor.StreamChunk{Payload: []byte("data: [DONE]\n\n")}
+						break
+					}
+					chunks := sdktranslator.TranslateStream(
+						ctx,
+						sdktranslator.FormatOpenAI,
+						targetFormat,
+						req.Model,
+						helps.ApplyPatchOriginalRequest(req, opts),
+						req.Payload,
+						dataPayload,
+						&param,
+					)
+					for _, c := range chunks {
+						outChan <- cliproxyexecutor.StreamChunk{Payload: c}
+					}
+				}
+			}
+			if errLine != nil {
+				if errLine != io.EOF && ctx.Err() == nil {
+					log.Warnf("workbuddy stream read error: %v", errLine)
+				}
+				break
+			}
+		}
+	}()
+
+	return &cliproxyexecutor.StreamResult{
+		Chunks:  outChan,
+		Headers: httpResp.Header.Clone(),
+	}, nil
+}
+
+// normalizeWorkBuddyPayload validates system prompt presence and handles DeepSeek reasoning fields.
+func normalizeWorkBuddyPayload(payload []byte, model string) []byte {
+	cleanModel := cleanWorkBuddyModel(model)
+	if cleanModel != "" {
+		payload, _ = sjson.SetBytes(payload, "model", cleanModel)
+	}
+
+	// Ensure system prompt is present
+	messages := gjson.GetBytes(payload, "messages")
+	if !messages.Exists() || len(messages.Array()) == 0 || messages.Array()[0].Get("role").String() != "system" {
+		sysMsg := map[string]string{"role": "system", "content": defaultWorkBuddySystemPrompt}
+		sysJSON, _ := json.Marshal(sysMsg)
+		var rawArr []json.RawMessage
+		rawArr = append(rawArr, sysJSON)
+		for _, m := range messages.Array() {
+			rawArr = append(rawArr, json.RawMessage(m.Raw))
+		}
+		newMessages, _ := json.Marshal(rawArr)
+		payload, _ = sjson.SetRawBytes(payload, "messages", newMessages)
+	}
+
+	// Clean internal control markers
+	var markers []string
+	gjson.ParseBytes(payload).ForEach(func(key, _ gjson.Result) bool {
+		if strings.HasPrefix(key.String(), "_") {
+			markers = append(markers, key.String())
+		}
+		return true
+	})
+	for _, m := range markers {
+		payload, _ = sjson.DeleteBytes(payload, m)
+	}
+
+	return payload
+}

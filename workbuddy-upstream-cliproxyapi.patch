+package auth
+
+import "testing"
+
+func TestInferCredentialProvider(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name     string
+		path     string
+		declared string
+		metadata map[string]any
+		expected string
+	}{
+		{
+			name:     "declared provider is left alone",
+			path:     "/auth/xai-someone.json",
+			declared: "xai",
+			metadata: map[string]any{"refresh_token": "r"},
+			expected: "",
+		},
+		{
+			name:     "workbuddy credential with no type is read from its filename",
+			path:     "/auth/workbuddy-5da534ef-2b48-468c-bb4b-c203972e9376.json",
+			declared: "",
+			metadata: map[string]any{"access_token": "t", "refresh_token": "r"},
+			expected: "workbuddy",
+		},
+		{
+			name:     "legacy codebuddy filename maps to workbuddy",
+			path:     "/auth/codebuddy-abc.json",
+			declared: "",
+			metadata: map[string]any{"access_token": "t"},
+			expected: "workbuddy",
+		},
+		{
+			name:     "unknown type is treated as absent",
+			path:     "/auth/workbuddy-abc.json",
+			declared: "unknown",
+			metadata: map[string]any{"access_token": "t"},
+			expected: "workbuddy",
+		},
+		{
+			name:     "renamed workbuddy file is read from its body",
+			path:     "/auth/renamed-account.json",
+			declared: "",
+			metadata: map[string]any{"access_token": "t", "refresh_token": "r", "uid": "abc", "realm": "cn"},
+			expected: "workbuddy",
+		},
+		{
+			name:     "claude credential is read from its account uuid",
+			path:     "/auth/renamed-2.json",
+			declared: "",
+			metadata: map[string]any{"access_token": "t", "account_uuid": "u"},
+			expected: "claude",
+		},
+		{
+			name:     "codex credential is read from account id and plan",
+			path:     "/auth/renamed-3.json",
+			declared: "",
+			metadata: map[string]any{"access_token": "t", "account_id": "a", "plan_type": "plus"},
+			expected: "codex",
+		},
+		{
+			name:     "kimi credential is read from device id and domain",
+			path:     "/auth/renamed-4.json",
+			declared: "",
+			metadata: map[string]any{"access_token": "t", "device_id": "d", "domain": "kimi.com"},
+			expected: "kimi",
+		},
+		{
+			name:     "meta credential is read from its dca token",
+			path:     "/auth/renamed-5.json",
+			declared: "",
+			metadata: map[string]any{"access_token": "t", "dca_token": "d"},
+			expected: "meta",
+		},
+		{
+			name:     "devin credential is read from its session token",
+			path:     "/auth/renamed-6.json",
+			declared: "",
+			metadata: map[string]any{"session_token": "s"},
+			expected: "devin",
+		},
+		{
+			name:     "an unidentifiable file stays unknown",
+			path:     "/auth/mystery.json",
+			declared: "",
+			metadata: map[string]any{"something": "else"},
+			expected: "",
+		},
+	}
+
+	for _, test := range tests {
+		test := test
+		t.Run(test.name, func(t *testing.T) {
+			t.Parallel()
+			if got := inferCredentialProvider(test.path, test.declared, test.metadata); got != test.expected {
+				t.Fatalf("inferCredentialProvider(%q, %q) = %q, want %q",
+					test.path, test.declared, got, test.expected)
+			}
+		})
+	}
+}

+package executor
+
+import (
+	"testing"
+)
+
+func TestCleanWorkBuddyModel(t *testing.T) {
+	tests := []struct {
+		input    string
+		expected string
+	}{
+		{"default-model", "default-model"},
+		{"deepseek-v4.1-flash", "deepseek-v4.1-flash"},
+		{"workbuddy/deepseek-v4.1-flash", "deepseek-v4.1-flash"},
+		{"WorkBuddy/claude-3-7-sonnet", "claude-3-7-sonnet"},
+		{"codebuddy/gpt-4o", "gpt-4o"},
+		{"workbuddy:primary-model", "primary-model"},
+		{"workbuddy/deepseek-v4.1-flash(high)", "deepseek-v4.1-flash"},
+	}
+
+	for _, tc := range tests {
+		actual := cleanWorkBuddyModel(tc.input)
+		if actual != tc.expected {
+			t.Errorf("cleanWorkBuddyModel(%q) = %q; want %q", tc.input, actual, tc.expected)
+		}
+	}
+}
diff --git a/sdk/auth/filestore.go b/sdk/auth/filestore.go

+func (h *Handler) RequestWorkBuddyToken(c *gin.Context) {
+	ctx := context.Background()
+	ctx = PopulateAuthContext(ctx, c)
+
+	realm := strings.TrimSpace(c.Query("realm"))
+	if realm == "" {
+		realm = "intl"
+	}
+	platform := strings.TrimSpace(c.Query("platform"))
+	if platform == "" {
+		platform = "CLI"
+	}
+
+	authSvc := workbuddyauth.NewWorkBuddyAuth(h.cfg)
+
+	authURL, state, errStart := authSvc.StartLogin(ctx, realm, platform)
+	if errStart != nil {
+		log.Errorf("Failed to start WorkBuddy OAuth flow: %v", errStart)
+		c.JSON(http.StatusInternalServerError, gin.H{"error": "failed to start WorkBuddy authorization flow"})
+		return
+	}
+
+	RegisterOAuthSession(state, "workbuddy")
+
+	go func() {
+		pollCtx, cancelPoll := context.WithCancel(ctx)
+		defer cancelPoll()
+		go watchOAuthSessionCancel(pollCtx, cancelPoll, state, "workbuddy")
+
+		ticker := time.NewTicker(2 * time.Second)
+		defer ticker.Stop()
+		timeout := time.After(15 * time.Minute)
+
+		for {
+			select {
+			case <-pollCtx.Done():
+				return
+			case <-timeout:
+				if IsOAuthSessionPending(state, "workbuddy") {
+					SetOAuthSessionError(state, "WorkBuddy authorization timed out")
+				}
+				return
+			case <-ticker.C:
+				if !IsOAuthSessionPending(state, "workbuddy") {
+					return
+				}
+				tokenData, errPoll := authSvc.PollToken(pollCtx, state, realm)
+				if errPoll != nil {
+					log.Errorf("WorkBuddy authentication poll error: %v", errPoll)
+					SetOAuthSessionError(state, oauthSessionErrorWithCause("Authentication failed", errPoll))
+					return
+				}
+				if tokenData == nil {
+					continue
+				}
+
+				fileName := workbuddyauth.CredentialFileName(tokenData.UID)
+				label := fmt.Sprintf("WorkBuddy (%s)", tokenData.UID[:min(8, len(tokenData.UID))])
+
+				metadata := map[string]any{
+					"type":          "workbuddy",
+					"uid":           tokenData.UID,
+					"access_token":  tokenData.AccessToken,
+					"refresh_token": tokenData.RefreshToken,
+					"token_type":    tokenData.TokenType,
+					"expires_in":    tokenData.ExpiresIn,
+					"expires_at":    tokenData.ExpiresAt,
+					"realm":         realm,
+					"platform":      platform,
+					"source":        "oauth",
+					"auth_kind":     "oauth",
+				}
+
+				attrs := map[string]string{
+					"auth_kind": "oauth",
+					"uid":       tokenData.UID,
+					"realm":     realm,
+				}
+
+				record := &coreauth.Auth{
+					ID:         fileName,
+					Provider:   "workbuddy",
+					FileName:   fileName,
+					Label:      label,
+					Metadata:   metadata,
+					Attributes: attrs,
+				}
+
+				if errGuard := guardOAuthSessionPendingForSave(state, "workbuddy"); errGuard != nil {
+					return
+				}
+				savedPath, errSave := h.saveTokenRecord(ctx, record)
+				if errSave != nil {
+					log.Errorf("Failed to save WorkBuddy token to file: %v", errSave)
+					SetOAuthSessionError(state, "Failed to save credentials")
+					return
+				}
+
+				CompleteOAuthSession(state)
+				fmt.Printf("WorkBuddy authentication successful! Token saved to %s\n", savedPath)
+				return
+			}
+		}
+	}()
+
+	c.JSON(200, gin.H{
+		"status":     "ok",
+		"url":        authURL,
+		"state":      state,
+		"expires_in": 900,
+	})
+}

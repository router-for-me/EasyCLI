+// Package workbuddy provides authentication, device fingerprint derivation,
+// and token management for Tencent WorkBuddy (workbuddy.ai / copilot.tencent.com).
+package workbuddy
+
+import (
+	"bytes"
+	"context"
+	"crypto/md5"
+	"encoding/base64"
+	"encoding/hex"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"strings"
+	"time"
+
+	"github.com/google/uuid"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/util"
+	"github.com/tidwall/gjson"
+)
+
+const (
+	// WorkBuddyIntlOrigin is the base origin for international WorkBuddy accounts.
+	WorkBuddyIntlOrigin = "https://www.workbuddy.ai"
+	// WorkBuddyCNOrigin is the base origin for domestic CodeBuddy/Tencent accounts.
+	WorkBuddyCNOrigin = "https://copilot.tencent.com"
+	// AuthStatePath is the endpoint to initialize an OAuth login state.
+	AuthStatePath = "/v2/plugin/auth/state"
+	// AuthTokenPath is the endpoint to poll for issued OAuth tokens.
+	AuthTokenPath = "/v2/plugin/auth/token"
+
+	IntlClientVersion = "5.5.2"
+	CNClientVersion   = "5.5.6"
+
+	IntlUserAgent = "WorkBuddy/5.5.2 WorkBuddy AI/5.5.2 CLI/5.5.2"
+	CNUserAgent   = "WorkBuddy/5.5.6 WorkBuddy/5.5.6 CLI/2.137.1"
+)
+
+// WorkBuddyAuth handles WorkBuddy OAuth and identity management.
+type WorkBuddyAuth struct {
+	cfg        *config.Config
+	httpClient *http.Client
+}
+
+// NewWorkBuddyAuth creates a WorkBuddy authentication helper.
+func NewWorkBuddyAuth(cfg *config.Config) *WorkBuddyAuth {
+	var sdkCfg config.SDKConfig
+	if cfg != nil {
+		sdkCfg = cfg.SDKConfig
+		if sdkCfg.ProxyURL == "" {
+			sdkCfg.ProxyURL = strings.TrimSpace(cfg.ProxyURL)
+		}
+	}
+	return &WorkBuddyAuth{
+		cfg:        cfg,
+		httpClient: util.SetProxy(&sdkCfg, &http.Client{Timeout: 30 * time.Second}),
+	}
+}
+
+// WorkBuddyTokenData contains token information issued by WorkBuddy.
+type WorkBuddyTokenData struct {
+	AccessToken  string `json:"accessToken"`
+	RefreshToken string `json:"refreshToken"`
+	TokenType    string `json:"tokenType"`
+	ExpiresIn    int64  `json:"expiresIn"`
+	ExpiresAt    int64  `json:"expiresAt"`
+	UID          string `json:"uid"`
+	Realm        string `json:"realm"`
+}
+
+// DeriveID derives a deterministic 32-character hex identifier from uid and salt.
+// Consistent with workbuddy2api-hub's derive_id to prevent upstream risk control flags.
+func DeriveID(uid, salt string) string {
+	u := strings.TrimSpace(uid)
+	if u == "" {
+		u = "anonymous"
+	}
+	seed := fmt.Sprintf("%s:%s", salt, u)
+	hash := md5.Sum([]byte(seed))
+	return hex.EncodeToString(hash[:])
+}
+
+// GenerateRequestID generates a request ID with a deterministic prefix and microsecond timestamp.
+func GenerateRequestID(uid string) string {
+	prefix := DeriveID(uid, "req")
+	micro := time.Now().UnixNano() / 1000 % 1000000
+	return fmt.Sprintf("%s-%06d", prefix, micro)
+}
+
+// OriginForRealm returns the API host URL according to the realm.
+func OriginForRealm(realm string) string {
+	if strings.EqualFold(strings.TrimSpace(realm), "cn") {
+		return WorkBuddyCNOrigin
+	}
+	return WorkBuddyIntlOrigin
+}
+
+// DomainForRealm returns the domain string for X-Domain header.
+func DomainForRealm(realm string) string {
+	parsed, err := url.Parse(OriginForRealm(realm))
+	if err == nil && parsed.Host != "" {
+		return parsed.Host
+	}
+	if strings.EqualFold(strings.TrimSpace(realm), "cn") {
+		return "copilot.tencent.com"
+	}
+	return "www.workbuddy.ai"
+}
+
+// BuildIdentityHeaders constructs the required WorkBuddy headers for an upstream call.
+func BuildIdentityHeaders(realm, uid, token, conversationID string) map[string]string {
+	isCN := strings.EqualFold(strings.TrimSpace(realm), "cn")
+	clientVer := IntlClientVersion
+	chatUA := IntlUserAgent
+	domain := DomainForRealm(realm)
+
+	if isCN {
+		clientVer = CNClientVersion
+		chatUA = CNUserAgent
+	}
+
+	effectiveUID := strings.TrimSpace(uid)
+	if effectiveUID == "" {
+		effectiveUID = "anonymous"
+	}
+
+	headers := map[string]string{
+		"X-Agent-Purpose": "conversation",
+		"X-IDE-Name":      "WorkBuddy",
+		"X-IDE-Type":      "WorkBuddy",
+		"X-IDE-Version":   clientVer,
+		"X-Product":       "WorkBuddy",
+		"X-Domain":        domain,
+		"User-Agent":      chatUA,
+		"X-User-Id":       effectiveUID,
+		"X-Request-ID":    GenerateRequestID(effectiveUID),
+	}
+
+	if token != "" {
+		headers["Authorization"] = "Bearer " + strings.TrimSpace(token)
+	}
+
+	if conversationID != "" {
+		headers["X-Conversation-ID"] = conversationID
+	} else {
+		headers["X-Conversation-ID"] = strings.ToUpper(uuid.New().String())
+	}
+
+	return headers
+}
+
+// ExtractUIDFromJWT extracts the user identifier from a JWT access token.
+func ExtractUIDFromJWT(token string) string {
+	parts := strings.Split(token, ".")
+	if len(parts) < 2 {
+		return ""
+	}
+	payloadSegment := parts[1]
+	decoded, err := base64.RawURLEncoding.DecodeString(payloadSegment)
+	if err != nil {
+		decoded, err = base64.URLEncoding.DecodeString(payloadSegment)
+		if err != nil {
+			decoded, err = base64.StdEncoding.DecodeString(payloadSegment)
+			if err != nil {
+				return ""
+			}
+		}
+	}
+	uid := gjson.GetBytes(decoded, "uid").String()
+	if uid == "" {
+		uid = gjson.GetBytes(decoded, "sub").String()
+	}
+	if uid == "" {
+		uid = gjson.GetBytes(decoded, "userId").String()
+	}
+	return strings.TrimSpace(uid)
+}
+
+// CredentialFileName returns the file name for storing a WorkBuddy auth record.
+func CredentialFileName(uid string) string {
+	cleanUID := strings.Map(func(r rune) rune {
+		if (r >= 'a' && r <= 'z') || (r >= 'A' && r <= 'Z') || (r >= '0' && r <= '9') || r == '-' || r == '_' {
+			return r
+		}
+		return '-'
+	}, strings.TrimSpace(uid))
+	if cleanUID == "" {
+		cleanUID = fmt.Sprintf("wb-%d", time.Now().Unix())
+	}
+	return fmt.Sprintf("workbuddy-%s.json", cleanUID)
+}
+
+// StartLogin initializes the OAuth authorization flow with WorkBuddy.
+func (a *WorkBuddyAuth) StartLogin(ctx context.Context, realm, platform string) (authURL string, state string, err error) {
+	if strings.TrimSpace(platform) == "" {
+		platform = "CLI"
+	}
+	origin := OriginForRealm(realm)
+	endpoint := fmt.Sprintf("%s%s?platform=%s", origin, AuthStatePath, url.QueryEscape(platform))
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, endpoint, bytes.NewReader([]byte("{}")))
+	if err != nil {
+		return "", "", fmt.Errorf("create auth state request: %w", err)
+	}
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("Accept", "application/json, text/plain, */*")
+	req.Header.Set("User-Agent", IntlUserAgent)
+	req.Header.Set("Origin", origin)
+	req.Header.Set("Referer", origin+"/")
+
+	resp, err := a.httpClient.Do(req)
+	if err != nil {
+		return "", "", fmt.Errorf("request auth state: %w", err)
+	}
+	defer resp.Body.Close()
+
+	body, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return "", "", fmt.Errorf("read auth state body: %w", err)
+	}
+
+	parsedState := gjson.GetBytes(body, "data.state").String()
+	parsedURL := gjson.GetBytes(body, "data.authUrl").String()
+	if parsedState == "" || parsedURL == "" {
+		return "", "", fmt.Errorf("auth state returned invalid payload: %s", string(body))
+	}
+
+	return parsedURL, parsedState, nil
+}
+
+// PollToken polls the WorkBuddy token endpoint. Returns nil, nil while waiting for the user.
+func (a *WorkBuddyAuth) PollToken(ctx context.Context, state, realm string) (*WorkBuddyTokenData, error) {
+	origin := OriginForRealm(realm)
+	endpoint := fmt.Sprintf("%s%s?state=%s", origin, AuthTokenPath, url.QueryEscape(state))
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, endpoint, nil)
+	if err != nil {
+		return nil, fmt.Errorf("create auth token poll request: %w", err)
+	}
+	req.Header.Set("Accept", "application/json, text/plain, */*")
+	req.Header.Set("User-Agent", IntlUserAgent)
+
+	resp, err := a.httpClient.Do(req)
+	if err != nil {
+		return nil, fmt.Errorf("poll auth token: %w", err)
+	}
+	defer resp.Body.Close()
+
+	body, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return nil, fmt.Errorf("read auth token body: %w", err)
+	}
+
+	code := gjson.GetBytes(body, "code").Int()
+	if code == 11217 {
+		// 11217 means "login ing..."
+		return nil, nil
+	}
+
+	if code != 0 {
+		msg := gjson.GetBytes(body, "msg").String()
+		if msg == "" {
+			msg = fmt.Sprintf("error code %d", code)
+		}
+		return nil, fmt.Errorf("authorization failed: %s", msg)
+	}
+
+	data := gjson.GetBytes(body, "data")
+	accessToken := strings.TrimSpace(data.Get("accessToken").String())
+	if accessToken == "" {
+		return nil, fmt.Errorf("token exchange returned empty access token")
+	}
+
+	refreshToken := strings.TrimSpace(data.Get("refreshToken").String())
+	tokenType := data.Get("tokenType").String()
+	expiresIn := data.Get("expiresIn").Int()
+	now := time.Now().Unix()
+	expiresAt := now + expiresIn
+	if expiresIn <= 0 {
+		expiresAt = now + 2592000
+	}
+
+	uid := ExtractUIDFromJWT(accessToken)
+	if uid == "" {
+		uid = fmt.Sprintf("wb-%s", state[:min(8, len(state))])
+	}
+
+	return &WorkBuddyTokenData{
+		AccessToken:  accessToken,
+		RefreshToken: refreshToken,
+		TokenType:    tokenType,
+		ExpiresIn:    expiresIn,
+		ExpiresAt:    expiresAt,
+		UID:          uid,
+		Realm:        realm,
+	}, nil
+}
+
+func min(a, b int) int {
+	if a < b {
+		return a
+	}
+	return b
+}

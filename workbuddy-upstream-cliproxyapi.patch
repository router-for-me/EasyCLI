--- a/sdk/auth/filestore.go
+++ b/sdk/auth/filestore.go
@@ -251,6 +251,13 @@ func (s *FileTokenStore) readAuthFiles(path, baseDir string) ([]*cliproxyauth.Au
 	}
 	provider, _ := metadata["type"].(string)
 	provider = strings.TrimSpace(provider)
+	// A credential JSON that names no provider used to load as provider
+	// "unknown": listed, but routed nowhere, so the account looked present and
+	// silently never served a request. The name and the credential's own shape
+	// usually say plainly which provider wrote it, so fill that in here.
+	if inferred := inferCredentialProvider(path, provider, metadata); inferred != "" {
+		provider = inferred
+	}
 	if strings.EqualFold(provider, "gemini") {
 		return nil, nil
 	}
@@ -451,6 +458,107 @@ func (s *FileTokenStore) resolveAuthPath(auth *cliproxyauth.Auth) (string, error
 	return filepath.Join(dir, auth.ID), nil
 }
 
+// credentialProviderPrefixes maps a credential filename prefix to the provider
+// that writes it. Every built-in authenticator names its files this way, so the
+// name survives even when the JSON body was edited by hand, produced by an
+// older build, or exported from another machine without its `type` field.
+var credentialProviderPrefixes = []struct {
+	prefix   string
+	provider string
+}{
+	{"workbuddy-", "workbuddy"},
+	{"codebuddy-", "workbuddy"},
+	{"antigravity-", "antigravity"},
+	{"claude-", "claude"},
+	{"codex-", "codex"},
+	{"kimi-ai-", "kimi-ai"},
+	{"kimi-", "kimi"},
+	{"xai-", "xai"},
+	{"grok-", "xai"},
+	{"meta-", "meta"},
+	{"devin-", "devin"},
+}
+
+// inferCredentialProvider decides which provider owns a credential file whose
+// `type` field is absent or unrecognized.
+//
+// It exists because the runtime treats a missing type as provider "unknown",
+// which the scheduler never routes to - the credential is loaded, shown, and
+// then never used. Both signals it reads are the credential's own: the filename
+// the provider's authenticator chose, and the field names in the body, which
+// differ enough between providers to be conclusive on their own.
+//
+// `declared` is the type the file did name; an unrecognized value is treated as
+// absent because that is how the runtime would treat it.
+func inferCredentialProvider(path string, declared string, metadata map[string]any) string {
+	declared = strings.TrimSpace(declared)
+	if declared != "" && !strings.EqualFold(declared, "unknown") {
+		return ""
+	}
+
+	// Filename first: it is the cheapest read and is what the app itself shows
+	// the user, so agreeing with it keeps the list and the routing consistent.
+	name := strings.ToLower(strings.TrimSpace(filepath.Base(path)))
+	if name != "" {
+		for _, entry := range credentialProviderPrefixes {
+			if strings.HasPrefix(name, entry.prefix) {
+				return entry.provider
+			}
+		}
+	}
+
+	// Then the body. Each test looks for a field only that provider's own
+	// credential schema carries, so a file that merely lacks a type still lands
+	// on the right executor.
+	if _, ok := metadata["dca_token"].(string); ok {
+		return "meta"
+	}
+	if _, ok := metadata["session_token"].(string); ok {
+		return "devin"
+	}
+	// WorkBuddy and Kimi both name the account uid; what separates them is that
+	// a WorkBuddy credential carries the OAuth metadata its login flow writes.
+	if _, ok := metadata["uid"].(string); ok {
+		if _, hasRealm := metadata["realm"].(string); hasRealm {
+			return "workbuddy"
+		}
+		if _, hasPlatform := metadata["platform"].(string); hasPlatform {
+			return "workbuddy"
+		}
+	}
+	if _, ok := metadata["account_uuid"].(string); ok {
+		return "claude"
+	}
+	if _, ok := metadata["organization_uuid"].(string); ok {
+		return "claude"
+	}
+	if _, ok := metadata["account_id"].(string); ok {
+		if _, hasPlan := metadata["plan_type"]; hasPlan {
+			return "codex"
+		}
+	}
+	if _, ok := metadata["device_id"].(string); ok {
+		if _, hasDomain := metadata["domain"].(string); hasDomain {
+			return "kimi"
+		}
+	}
+	if _, ok := metadata["sub"].(string); ok {
+		if _, hasBase := metadata["base_url"].(string); hasBase {
+			return "xai"
+		}
+	}
+
+	// An OAuth credential with a refresh token and no other tell is one of the
+	// two WorkBuddy-family providers; "workbuddy" is the identifier the
+	// executor and the GUI both use, and codebuddy is its legacy alias.
+	if kind, _ := metadata["auth_kind"].(string); strings.EqualFold(strings.TrimSpace(kind), "oauth") {
+		if _, hasRefresh := metadata["refresh_token"].(string); hasRefresh {
+			return "workbuddy"
+		}
+	}
+	return ""
+}

@@ -0,0 +1,60 @@
+package auth
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+// A credential file whose JSON names no provider must still load under the
+// provider its own name and fields identify: provider "unknown" is listed by
+// the management API but never selected for a request.
+func TestFileTokenStore_List_InfersProviderWhenTypeIsAbsent(t *testing.T) {
+	ctx := context.Background()
+	baseDir := t.TempDir()
+
+	workbuddy := filepath.Join(baseDir, "workbuddy-5da534ef-2b48-468c-bb4b-c203972e9376.json")
+	if err := os.WriteFile(workbuddy, []byte(
+		`{"access_token":"t","refresh_token":"r","uid":"5da534ef","realm":"cn","auth_kind":"oauth"}`,
+	), 0o600); err != nil {
+		t.Fatalf("seed workbuddy file: %v", err)
+	}
+
+	// Same body, filename says nothing: the fields alone must decide.
+	renamed := filepath.Join(baseDir, "imported-account.json")
+	if err := os.WriteFile(renamed, []byte(
+		`{"access_token":"t","refresh_token":"r","uid":"abc","platform":"CLI"}`,
+	), 0o600); err != nil {
+		t.Fatalf("seed renamed file: %v", err)
+	}
+
+	// Nothing identifies this one, so it must keep the unknown label rather
+	// than be guessed into a provider that would then reject its requests.
+	mystery := filepath.Join(baseDir, "mystery.json")
+	if err := os.WriteFile(mystery, []byte(`{"something":"else"}`), 0o600); err != nil {
+		t.Fatalf("seed mystery file: %v", err)
+	}
+
+	store := NewFileTokenStore()
+	store.SetBaseDir(baseDir)
+
+	loaded, err := store.List(ctx)
+	if err != nil {
+		t.Fatalf("List() error: %v", err)
+	}
+	providers := map[string]string{}
+	for _, entry := range loaded {
+		providers[entry.FileName] = entry.Provider
+	}
+
+	if got := providers["workbuddy-5da534ef-2b48-468c-bb4b-c203972e9376.json"]; got != "workbuddy" {
+		t.Errorf("workbuddy file provider = %q, want %q", got, "workbuddy")
+	}
+	if got := providers["imported-account.json"]; got != "workbuddy" {
+		t.Errorf("renamed file provider = %q, want %q", got, "workbuddy")
+	}
+	if got := providers["mystery.json"]; got != "unknown" {
+		t.Errorf("mystery file provider = %q, want %q", got, "unknown")
+	}
+}
